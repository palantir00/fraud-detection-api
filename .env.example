# Wzór pliku .env — SKOPIUJ go jako .env i uzupełnij wartości.
#   cp .env.example .env
# Ten plik (.example) trafia do repo. Plik .env NIGDY.

# --- Baza danych ---
# Te trzy zmienne czyta kontener Postgresa przy pierwszym starcie
# i na ich podstawie zakłada użytkownika i bazę.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Adres bazy widziany z wnętrza sieci docker-compose.
# "db" to nazwa serwisu z docker-compose.yml, nie localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Pełny adres połączenia, którego użyje SQLAlchemy.
# Format: postgresql+psycopg://UZYTKOWNIK:HASLO@HOST:PORT/BAZA
DATABASE_URL=

# --- Opcjonalne: zewnętrzne API do geolokalizacji (Etap 2) ---
# Zostaw puste, jeśli reguła geograficzna działa tylko na polu "country".
GEO_API_KEY=
