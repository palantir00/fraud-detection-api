# Template for the .env file. Copy it and fill in the values:
#   cp .env.example .env
# This template is committed. The .env file never is.

# --- Database ---
# Postgres reads these three on first startup and creates
# the user and the database from them.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database address as seen from inside the docker-compose network.
# "db" is the service name from docker-compose.yml, not localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection string used by SQLAlchemy.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# --- Optional: external geolocation API (stage 2) ---
# Leave empty if the geography rule only uses the "country" field.
GEO_API_KEY=
